# Files EAS Build does not upload. It replaces .gitignore for EAS, and the one
# difference is that `.env` IS uploaded, so the keys in it (OpenRouter, Gemini)
# are built into the APK. Keep .env out of git all the same.

# dependencies
node_modules/

# expo
.expo/
dist/
web-build/
expo-env.d.ts

# native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macos
.DS_Store
*.pem

# local env overrides
.env*.local

# typescript
*.tsbuildinfo

# Native projects are generated by EAS (Continuous Native Generation)
/android
/ios

# Claude Code / Impeccable working files, not part of the app
.claude/
.impeccable/
