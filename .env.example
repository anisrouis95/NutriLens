# Copy this file to `.env` (it is git-ignored) and fill in what you use.
#
# AI keys. The app tries Gemini, then Groq, then OpenRouter, all on free plans
# with no card; set as many as you like (more keys = more free requests a day).
# Keys set here are baked into the app's JavaScript, so only ever use keys on
# free plans with no payment method attached. A key pasted in the app
# (Profile → AI) takes priority over the one here.

# Gemini: aistudio.google.com/apikey → Create API key (free, no card).
EXPO_PUBLIC_GEMINI_API_KEY=

# Groq: console.groq.com/keys → Create API key (free, no card).
EXPO_PUBLIC_GROQ_API_KEY=

# OpenRouter: openrouter.ai/keys. Set this key's credit limit to $0 so it can
# only ever use free models (about 50 requests a day without credits).
EXPO_PUBLIC_OPENROUTER_API_KEY=

# Firebase console → Authentication → Sign-in method → Google →
# "Web SDK configuration" → Web client ID. Not a secret. Needed for Google
# sign-in on Android. For EAS cloud builds also put it in eas.json → env.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
