# Copy this file to `.env` (it is git-ignored) and fill in what you use.

# Optional. Normally you paste the Gemini key in the app (Profile → AI food
# scanning), where it is stored encrypted on the phone. Setting it here bakes
# it into the JavaScript bundle instead — only do that for local testing.
EXPO_PUBLIC_GEMINI_API_KEY=

# Optional. Your OpenRouter key, so you don't have to paste it in the app.
# It is baked into the app's JavaScript: on openrouter.ai → Keys, set this
# key's credit limit to $0 so it can only ever use free models. A key pasted
# in the app (Profile) takes priority over this one.
EXPO_PUBLIC_OPENROUTER_API_KEY=

# Firebase console → Authentication → Sign-in method → Google →
# "Web SDK configuration" → Web client ID. Not a secret. Needed for Google
# sign-in on Android. For EAS cloud builds also put it in eas.json → env.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
